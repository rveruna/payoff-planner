{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@domain/*": ["../src/domain/*"],
      "@/*": ["./src/*"],
      "zod": ["./node_modules/zod"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "../src/domain/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-native", "../src/domain/**/*.test.ts"]
}
