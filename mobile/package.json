{
  "name": "payoff-planner-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "e2e": "node e2e/run.mjs",
    "bundle:native": "expo export --platform ios --platform android --output-dir dist-native"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@hookform/resolvers": "^5.9.1",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
